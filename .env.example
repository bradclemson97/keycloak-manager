# ── Keycloak connection (admin client) ───────────────────────────────────────
# URL that KM uses to talk to Keycloak's admin API (internal network in prod)
KEYCLOAK_AUTH_URL=http://localhost:9000

# Issuer URI used to validate incoming Bearer tokens
KEYCLOAK_ISSUER_URI=http://localhost:9000/realms/system

KEYCLOAK_REALM=system
KEYCLOAK_MANAGER_CLIENT=system-manager-service
# Secret for the system-manager-service client in Keycloak (Clients → Credentials)
KEYCLOAK_MANAGER_SECRET=your-client-secret-here

# ── Downstream service URLs ───────────────────────────────────────────────────
USER_MANAGER_URL=http://localhost:8080

# ── Optional overrides ────────────────────────────────────────────────────────
# SERVER_PORT=8210
